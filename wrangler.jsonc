{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serenely",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"],
    "not_found_handling": "single-page-application"
  }
}
