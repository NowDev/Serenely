{
  "name": "serenely",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --import tsx scripts/build-audio.ts",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview:cloudflare": "wrangler dev --config wrangler.workers.jsonc --ip 127.0.0.1",
    "deploy:workers": "npm run build && wrangler deploy --config wrangler.workers.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  }
}
